#!/usr/bin/env python3
"""
module_name: tg_ticket_dir
description: Print the vault folder of one ticket, flat or under its prefix folder. Exit 1 with "not found" on stderr when there is none.
author: Dipen Patel (dipenpatel-dev)
date:
version: 1.0.0
change_log:
  1.0.0: Initial CLI for the ticket folder lookup, so command files stop assuming a flat ticket folder.
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
from core.paths import NotSetUp, ticket_folder  # noqa: E402


def main(argv):
    if len(argv) != 2:
        sys.stderr.write("usage: tg_ticket_dir <KEY>\n")
        return 2
    try:
        folder = ticket_folder(argv[1])
    except (NotSetUp, KeyError) as exc:
        sys.stderr.write(str(exc) + "\n")
        return 1
    if folder is None:
        sys.stderr.write("not found: no ticket folder for the key given\n")
        return 1
    print(folder)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
